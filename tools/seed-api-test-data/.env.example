# Copy to .env and adjust. Direct microservice URLs bypass the Kong JWT
# gate so seeded data can be created without a token. Web and mobile apps
# keep using the gateway (EXPO_PUBLIC_API_URL=http://<host>:8080).
#
# On a phone/emulator, <host> must be your PC LAN IP (not localhost).
IDENTITY_URL=http://localhost:8081
AUTHORIZATION_URL=http://localhost:8082
ACADEMIC_URL=http://localhost:8083
SCHEDULING_URL=http://localhost:8084
ATTENDANCE_URL=http://localhost:8085
BIOMETRIC_URL=http://localhost:8086
CONFIGURATION_URL=http://localhost:8087
NOTIFICATION_URL=http://localhost:8088
QUALITY_URL=http://localhost:8089

# Login created by the seed. POST /api/v1/users bcrypt-hashes the password, so the
# plaintext below is only an input, never stored. Local testing only.
SEED_USERNAME=seed.admin
SEED_PASSWORD=SeedAdmin123!
