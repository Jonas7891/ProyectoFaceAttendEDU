  "termsModal": {
    "title": "TERMS AND CONDITIONS",
    "acceptanceTitle": "1. ACCEPTANCE OF TERMS",
    "acceptanceText": "By accessing, registering and using this mobile application, the user declares that they have freely, previously, expressly and informedly read, understood and accepted these Terms and Conditions, as well as the Personal Data Processing Policy.",
    "objectTitle": "2. PURPOSE OF THE APPLICATION",
    "objectText": "The purpose of the application is to manage user attendance registration in public or private spaces using facial recognition technology, allowing automated identity validation.",
    "authorizationTitle": "3. AUTHORIZATION FOR THE PROCESSING OF PERSONAL DATA",
    "authorizationText": "The user previously, expressly and informedly authorizes the application owner to collect, store, use, process and delete their personal data, in accordance with current Colombian legislation.",
    "sensitiveDataTitle": "4. PROCESSING OF SENSITIVE DATA (BIOMETRIC)",
    "sensitiveDataText": "The user expressly authorizes the processing of their biometric data (facial image), which is considered sensitive data, for the following purposes:",
    "purpose1": "4.1 Validate the user's identity.",
    "purpose2": "4.2 Register their attendance in authorized places.",
    "purpose3": "4.3 Prevent impersonation or fraud.",
    "sensitiveDataNote": "The user acknowledges that they are not obliged to authorize the processing of sensitive data; however, they understand that refusal may prevent the use of the application.",
    "finalityTitle": "5. PURPOSE OF DATA PROCESSING",
    "finalityText": "The personal data collected will be used to:",
    "finality1": "5.1 Attendance registration and control.",
    "finality2": "5.2 User identification.",
    "finality3": "5.3 Security and access control.",
    "finality4": "5.4 Compliance with legal obligations.",
    "finality5": "5.5 Service improvement.",
    "rightsTitle": "6. RIGHTS OF THE DATA SUBJECT",
    "rightsText": "The user, as the owner of the personal data, has the right to:",
    "rights1": "6.1 Know, update and correct their data.",
    "rights2": "6.2 Request proof of the authorization granted.",
    "rights3": "6.3 Be informed about the use of their data.",
    "rights4": "6.4 Revoke the authorization and/or request the deletion of their data.",
    "rights5": "6.5 Access their personal data for free.",
    "rightsNote": "To exercise these rights, the user can communicate through the channels established by the application.",
    "storageTitle": "7. INFORMATION STORAGE AND SECURITY",
    "storageText1": "Personal data will be stored for as long as necessary to fulfill the described purposes or according to applicable legal provisions.",
    "storageText2": "The application will implement technical, human and administrative security measures to protect the information against unauthorized access, loss, misuse or fraud.",
    "transferTitle": "8. DATA TRANSFER AND TRANSMISSION",
    "transferText": "The user authorizes their personal data to be shared with third parties responsible for processing, only when necessary for the operation of the application or by legal requirement, in all cases guaranteeing the protection of the information.",
    "responsibilitiesTitle": "9. USER RESPONSIBILITIES",
    "responsibilitiesText": "The user undertakes to:",
    "responsibilities1": "9.1 Provide truthful and updated information.",
    "responsibilities2": "9.2 Use the application appropriately.",
    "responsibilities3": "9.3 Not impersonate third parties.",
    "responsibilities4": "9.4 Comply with applicable rules when using the service.",
    "liabilityTitle": "10. LIMITATION OF LIABILITY",
    "liabilityText": "The application will not be responsible for:",
    "liability1": "10.1 Technical failures beyond its control.",
    "liability2": "10.2 Misuse of the system by the user.",
    "liability3": "10.3 Unauthorized access resulting from user negligence.",
    "modificationsTitle": "11. MODIFICATIONS",
    "modificationsText": "The application reserves the right to modify these Terms and Conditions at any time. Modifications will be promptly communicated to users.",
    "legislationTitle": "12. APPLICABLE LEGISLATION",
    "legislationText": "These Terms and Conditions are governed by the laws of the Republic of Colombia, especially Law 1581 of 2012 and its regulatory decrees.",
    "acceptanceFinalTitle": "13. FINAL ACCEPTANCE",
    "close": "Close",
