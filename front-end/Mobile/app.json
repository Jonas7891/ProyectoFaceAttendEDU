{
  "expo": {
    "name": "FaceAttend EDU",
    "slug": "FaceAttend EDU",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logoFaceAttend.png",
    "userInterfacestyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-localization",
      "@react-native-community/datetimepicker"
    ]
  }
}
