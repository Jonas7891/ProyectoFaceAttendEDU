DATABASE_URL=postgres://postgres:postgres@localhost:5432/faceattend_db?sslmode=disable
PORT=8090
KAFKA_BROKERS=localhost:9092

# --- Canal de correo (SERVICE.md §9.1) -------------------------------------
# SMTP_HOST vacío deshabilita el canal: POST /api/v1/emails responde
# 202 {"status":"skipped"} y solo deja un WARN en los logs.
# Desarrollo local con MailHog (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit):
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FaceAttend EDU <no-reply@faceattend.local>
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
# Si se define, el cliente interno (01-ms-identity) debe enviar el header
# X-Internal-Token con el mismo valor. Vacío = sin exigencia (red interna).
EMAIL_INTERNAL_TOKEN=
