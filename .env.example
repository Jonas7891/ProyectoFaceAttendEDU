# FaceAttend EDU — template for the root environment file.
# Copy to `.env` and adjust per machine:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# Docker Compose auto-loads `.env` next to FULL/docker-compose.yml and uses it
# to interpolate every included file (database/, back-end/). The same file is
# also read by the services when they run outside Docker (Java imports it via
# spring.config.import; Node and Python load it at startup), so it is the
# single source for dev credentials: nothing below is a real secret. Never
# commit production secrets: override them via shell environment or a secrets
# manager.

# ── PostgreSQL 17 (1 instance, 8 schemas) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=faceattend_db
POSTGRES_PORT=5432
FACEATTEND_LIQUIBASE_IMAGE=liquibase/liquibase:4.29.0

# ── MongoDB 7 (biometric vectors) ──
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongopass
MONGO_DB=faceattend_biometric
MONGO_PORT=27017

# ── Redis 7 (Kong rate-limiting) ──
REDIS_PORT=6379

# ── Kafka 3.8 KRaft (domain events) ──
KAFKA_PORT=9092

# ── Kong gateway ──
KONG_PROXY_PORT=8080
KONG_ADMIN_PORT=8001

# ── Host binding ──
# BIND_IP scopes every non-edge port (5432, 27017, 6379, 9092, 8001 and
# 8081-8089) to loopback: reachable from this machine only, invisible to the
# rest of the LAN. Set 0.0.0.0 to expose them again (IDE debugging from
# another machine, for instance). Kong's proxy (8080) and the frontend (8090)
# are always published on 0.0.0.0 because browsers and phones need them.
BIND_IP=127.0.0.1

# ── Frontend web (Expo static + nginx) ──
# 8090 — free of clashes (8082 belongs to ms-authorization) and allowed by
# Kong CORS (3000 / 5173 / 8090). ms-authorization uses host port 8082.
FRONTEND_PORT=8090
# Browser-reachable backend URL baked at frontend build time.
# Physical devices/emulators must use the PC LAN IP, e.g. http://192.168.1.10:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# ── Biometría web (10-ms-face-auth: registro de rostro, reconocimiento, huella) ──
# Todo es opcional: compose trae estos valores por defecto. Base de datos propia
# (face-auth-postgres) + base `faceattend_face_auth` en el MongoDB compartido.
# El navegador accede vía Kong (/face-auth/*), nunca directo al servicio.
FACE_AUTH_PORT=8091                 # depuración en loopback (BIND_IP); interno = 8000
FACE_AUTH_POSTGRES_DB=face_auth
FACE_AUTH_POSTGRES_USER=faceauth
FACE_AUTH_POSTGRES_PASSWORD=faceauth
FACE_AUTH_MONGO_DB=faceattend_face_auth
FACE_AUTH_MATCH_THRESHOLD=0.6       # distancia máx. de rostro (menor = más estricto)
FACE_AUTH_FINGERPRINT_MATCH_THRESHOLD=8
# >= 32 caracteres. PRODUCCIÓN: cambiar por un valor aleatorio propio.
FACE_AUTH_JWT_SECRET=faceattend-dev-only-face-auth-jwt-secret-change-me

# ── Seed API test data (tools/seed-api-test-data, Node >= 20) ──
SEED_USERNAME=seed.admin
SEED_PASSWORD=SeedAdmin123!
BOOTSTRAP_USERNAME=admin.faceattend
BOOTSTRAP_PASSWORD=Admin123!ChangeMe

# ── SMTP email channel (08-ms-notification, SERVICE.md §9.1) ──
# Only ms-notification reads these (compose passes them through). SMTP_HOST
# empty disables the channel: POST /api/v1/emails answers 202 skipped and the
# service only logs a WARN; 01-ms-identity still returns 202 anti-enumeration.
# Dev mailbox (UI at http://localhost:8025):
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# Real account (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_STARTTLS=true, SMTP_USERNAME=<your gmail>, SMTP_FROM=FaceAttend EDU
#   <your gmail>, SMTP_PASSWORD=<16-char app password>: Google account ->
#   Security -> 2-Step Verification -> App passwords (your normal password is
#   rejected with "535 5.7.8 Username and Password not accepted").
#   The app password goes ONLY in SMTP_PASSWORD: EMAIL_INTERNAL_TOKEN is a
#   shared secret, never a password.
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FaceAttend EDU <no-reply@faceattend.local>
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
# Shared secret identity -> notification (X-Internal-Token): any random value
# (e.g. a GUID) that compose passes to both services. Empty = no check.
EMAIL_INTERNAL_TOKEN=

# ── Alert webhook (08-ms-notification, SERVICE.md §9.2) ──
# Only ms-notification reads these. WEBHOOK_URL empty disables delivery
# (no-op): EMAIL/PUSH alert_type.channel alerts otherwise POST a JSON
# payload here in the background when raised; DASHBOARD alerts never call it.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=5

# ── TLS (optional, docker-compose.tls.yml — see COMPOSE.md §10) ──
# Real domain with DNS -> this host (and api.<DOMAIN> for Mobile) for
# automatic Let's Encrypt certs. Left unset, Caddy uses "localhost" with its
# own local CA (fine to test the HTTPS flow, untrusted by real browsers).
DOMAIN=
